+    /// - the Token-2022 transfer-hook accounts of the pool's base mint, described by
+    ///   `remaining_accounts_info` (`TransferHookA` for mint0, `TransferHookB` for mint1); `None`
+    ///   when neither mint carries a transfer hook.
+    ///
+    /// Exact-in only. The instruction data is built from `zero_for_one` and the input amount.
+    Carpenter {
+        zero_for_one: bool,
+        hook_accounts: u8,
+        tick_arrays: u8,
+        remaining_accounts_info: Option<RemainingAccountsInfo>,
+    },
 }
 
